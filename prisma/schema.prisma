// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PayType {
  ADVANCE
  SALARY
  OVERTIME
  DEDUCTION
  BONUS
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveType {
  PAID
  UNPAID
}

enum attendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
  HOLIDAY
}

enum EmployeeActiveStatus {
  ACTIVE
  INACTIVE
}

model Admin {
  id        Int        @id @default(autoincrement())
  name      String
  phone     String     @unique
  email     String     @unique
  password  String
  employees Employee[]
}

model Office {
  id        Int        @id @default(autoincrement())
  name      String
  latitude  Float
  longitude Float
  checkin   DateTime
  checkout  DateTime
  breakTime Int        @default(0)
  employees Employee[]
  range            Int        @default(1000)
  autoFinalizeTime DateTime?
  lastFinalized    DateTime?
}

model Holiday {
  id          Int      @id @default(autoincrement())
  description String
  date        DateTime

  @@index([date])
}

model Employee {
  id            Int                  @id @default(autoincrement())
  name          String
  phone         String               @unique
  email         String               @unique
  joinedDate    DateTime?
  password      String
  baseSalary    Int
  overtimeRate  Int
  leaveBalance  Int                  @default(10) // initial balance, will decrease as leaves are approved
  status        EmployeeActiveStatus @default(ACTIVE)
  officeId      Int
  adminId       Int
  accountNumber String?
  ifscCode      String?
  office        Office               @relation(fields: [officeId], references: [id])
  admin         Admin                @relation(fields: [adminId], references: [id])
  leaves        Leave[]
  attendances   Attendance[]
  transactions  Transaction[]

  @@index([officeId, status])
  @@index([adminId])
}

model Leave {
  id        Int         @id @default(autoincrement())
  empId     Int
  reason    String
  applyDate DateTime    @default(now())
  fromDate  DateTime
  toDate    DateTime
  totalDays Int
  type      LeaveType
  status    LeaveStatus @default(PENDING)
  employee  Employee    @relation(fields: [empId], references: [id])

  @@index([empId, fromDate, toDate])
  @@index([empId, status])
  @@index([status])
}

model Attendance {
  id           Int              @id @default(autoincrement())
  empId        Int
  date         DateTime
  checkInTime  DateTime? // nullable
  checkOutTime DateTime? // nullable
  overTime     Int
  status       attendanceStatus
  employee     Employee         @relation(fields: [empId], references: [id])

  @@index([empId, date])
  @@index([date, status])
  @@index([empId])
}

model Transaction {
  id          Int      @id @default(autoincrement())
  empId       Int
  amount      Int
  date        DateTime
  payType     PayType
  description String?
  employee    Employee @relation(fields: [empId], references: [id])

  @@index([empId, date])
  @@index([date])
}
